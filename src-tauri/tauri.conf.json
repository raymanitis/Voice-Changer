{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxShift",
  "version": "2.0.0",
  "identifier": "com.raymanitis.voxshift",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VoxShift",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#1a1b1e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: mediastream:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "VoxShift",
    "shortDescription": "Real-time voice changer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
